{
  "name": "chatbot-agent-playground",
  "scripts": {
    "start": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "cd frontend && ng serve",
    "backend": "cd backend && node run-backend.js",
    "install:root": "npm install",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && node setup-venv.js",
    "install:all": "npm run install:root && npm run install:frontend && npm run install:backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}